# LLM provider: heuristic (offline, deterministic) | anthropic | openai
AILURA_LLM_PROVIDER=heuristic
AILURA_DEEP_MODEL=claude-opus-5
AILURA_QUICK_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint

# Data provider: synthetic | csv | yfinance
AILURA_DATA_PROVIDER=synthetic
AILURA_DATA_DIR=./data
AILURA_RESULTS_DIR=./results
AILURA_MEMORY_PATH=./.ailura/memory.jsonl

AILURA_MAX_DEBATE_ROUNDS=2
AILURA_MAX_RISK_ROUNDS=1
AILURA_EARLY_STOP_DEBATE=true
